# Flight Path Discovery - AzerothCore WotLK 3.3.5a
# First-release configuration generated from published GitHub SQL.
# Routes and destination prices are loaded directly from this configuration.
# MySQL route and price tables are no longer required.
# Restart worldserver after changing routes or prices.
# Routes are directional. Node IDs correspond to TaxiNodes.dbc.
# Prices are per destination in copper (100 copper = 1 silver).
# Faction restrictions must still be enforced in C++ via AzerothCore taxi masks.
# Location labels are human-readable comments; verify labels against your DBC.

[worldserver]
FlightPathDiscovery.Enable = 1
FlightPathDiscovery.TestCreatureEntry = 0
# Flight Path Discovery Board GameObject Entry, Default: 900100 (custom GameObject entry)
# Changing this value requires a valid GameObject template with the new entry ID.
FlightPathDiscovery.BoardEntry = 900100
FlightPathDiscovery.BoardDistance = 2.5
# Enable flight path discovery boards in Outland
FlightPathDiscovery.EnableOutland = 1
FlightPathDiscovery.EnableNorthrend = 0
FlightPathDiscovery.UnknownZoneLevel = 1
# Interval in seconds between nearby discovery-board recovery checks.
FlightPathDiscovery.BoardRecoveryInterval = 10

